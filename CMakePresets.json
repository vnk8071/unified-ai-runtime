{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-arm64-debug",
      "displayName": "Windows ARM64, Debug",
      "inherits": "windows-base",
      "architecture": { "value": "ARM64", "strategy": "set" }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64, Debug",
      "inherits": "windows-base",
      "architecture": { "value": "x64", "strategy": "set" }
    }
  ],
  "buildPresets": [
    { "name": "windows-arm64-debug", "configurePreset": "windows-arm64-debug", "configuration": "Debug" },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
